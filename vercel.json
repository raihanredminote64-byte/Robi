{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/admin.html", "destination": "/public/admin.html" },
    { "source": "/tonconnect-manifest.json", "destination": "/public/tonconnect-manifest.json" },
    { "source": "/robi.webp", "destination": "/public/robi.webp" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}